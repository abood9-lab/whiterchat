# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database connection string (MongoDB)
MONGODB_URI=

# Authentication secret for JWT tokens
JWT_SECRET=

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Model API Keys (Optional)
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Gmail SMTP Email Service (for sending real verification OTPs)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Alternative Generic SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Web Push Notifications (Optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:notifications@whiterchat.app"
